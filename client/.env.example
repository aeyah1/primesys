# Address of the API server. Online (Vercel), set it to the Render address,
# e.g. https://your-app.onrender.com (no trailing slash). Never put secret
# keys in this file: everything here is visible in the browser.
VITE_SERVER_URL=http://localhost:5000

# Optional: Cloudflare Turnstile site key for the sign-up bot challenge.
# Leave empty to disable (the server must also have CAPTCHA_ENABLED=true).
VITE_CAPTCHA_SITE_KEY=

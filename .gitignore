# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment files (NEVER commit secrets) ─────────────────
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# ── User uploads (real data, not source) ─────────────────────
server/uploads/
!server/uploads/.gitkeep

# ── Build output ─────────────────────────────────────────────
client/dist/
client/build/
dist/
build/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── Claude / local tooling ───────────────────────────────────
.claude/
.cache/

# ── Misc ─────────────────────────────────────────────────────
*.pid
*.seed
coverage/
.nyc_output/

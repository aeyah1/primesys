PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=primesys
# Time zone the database clock runs in. "local" (default) is right when MariaDB
# runs on this computer (XAMPP). The server warns at startup if the clocks
# differ; then set the database's offset, e.g. DB_TIMEZONE=+08:00
# DB_TIMEZONE=local

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Gmail account used to send verification & password-reset emails.
# Use a Google "App Password" (not your normal password):
#   https://myaccount.google.com/apppasswords
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASS=your-16-char-app-password

# Sign-up / sign-in abuse limits (optional; defaults shown)
# Windows are in minutes. Raise REGISTRATION_RATE_LIMIT if many people sign up
# from one network at once (e.g. a whole class in a computer lab).
# REGISTRATION_RATE_LIMIT=10       # new accounts per IP per window
# REGISTRATION_RATE_WINDOW=60
# LOGIN_IP_RATE_LIMIT=30           # failed sign-ins per IP per window
# LOGIN_IP_RATE_WINDOW=15
# LOGIN_MAX_ATTEMPTS=5             # failed sign-ins before an account is locked
# LOGIN_LOCKOUT_MINUTES=2          # first lock; each repeat doubles it
# LOGIN_LOCKOUT_MAX_MINUTES=30     # longest lock
# AUTH_EMAIL_RATE_LIMIT=5          # verification/reset requests per IP per hour
# AUTH_EMAIL_COOLDOWN_MINUTES=2    # minimum gap between emails to one account

# Reminders are emailed from the address above; each user may create this
# many per 24 hours.
# REMINDER_DAILY_LIMIT=20

# Who may sign up
# Public sign-up is for NEMSU faculty and staff: only these email domains may
# register (comma-separated). Set to * to allow any domain while testing
# locally. Accounts created by an admin in User Management are not restricted.
# For a demo without NEMSU accounts, add Gmail: ALLOWED_EMAIL_DOMAINS=nemsu.edu.ph,gmail.com
ALLOWED_EMAIL_DOMAINS=nemsu.edu.ph

# Optional bot challenge on sign-up (Cloudflare Turnstile)
# Off by default. To turn it on, set both of these and put the matching site
# key in client/.env as VITE_CAPTCHA_SITE_KEY. Never commit a real secret.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
